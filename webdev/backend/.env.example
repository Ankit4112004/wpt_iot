# Copy to .env and fill in. Locally you can leave everything blank — it defaults to
# SQLite + replay mode and runs with zero setup.

# Production database (Neon Postgres). Example:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Optional real IoT source. Leave blank to run purely on replay.
THINGSPEAK_CHANNEL=
THINGSPEAK_READ_KEY=

# Tuning (optional)
TICK_SECONDS=3
OVER_TEMP_C=38
